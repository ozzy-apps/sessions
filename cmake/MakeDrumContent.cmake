cmake_minimum_required(VERSION 3.16)
set(stage "${BUILD_DIR}/drum-content-stage")
file(REMOVE_RECURSE "${stage}")
execute_process(COMMAND ${CMAKE_COMMAND} -E env DESTDIR=${stage} ${CMAKE_COMMAND} --install ${BUILD_DIR} --prefix /usr --component DrumContent RESULT_VARIABLE rv OUTPUT_QUIET)
if(NOT rv EQUAL 0)
    message(FATAL_ERROR "Drum content staging failed")
endif()
if(NOT EXISTS "${stage}/usr/share/sessions/drum-content/library.json")
    message(FATAL_ERROR "Run fetch-drum-expansions.py and prepare-drum-expansions.py first")
endif()
execute_process(COMMAND dpkg --print-architecture OUTPUT_VARIABLE arch OUTPUT_STRIP_TRAILING_WHITESPACE)
string(TIMESTAMP stamp "%Y%m%d%H%M%S" UTC)
file(MAKE_DIRECTORY "${stage}/DEBIAN")
file(WRITE "${stage}/DEBIAN/control" "Package: sessions-drums\nVersion: ${VERSION}+${stamp}\nSection: sound\nPriority: optional\nArchitecture: all\nMaintainer: Sessions <sessions@localhost>\nDepends: sessions (>= 0.41.0), libsndfile1\nDescription: Recorded drum expansion libraries for Sessions\n Six native drum collections with recorded velocity layers, round robins and\n close, overhead and room sources where provided. Karoryfer libraries use CC0;\n DrumGizmo and Wilkinson Audio libraries use CC BY 4.0. Attribution, licenses\n and provenance are included under share/sessions/drum-content/licenses.\n")
file(MAKE_DIRECTORY "${OUT_DIR}")
set(package "${OUT_DIR}/sessions-drums_${VERSION}+${stamp}_all.deb")
execute_process(COMMAND chmod -R go-w,go+rX "${stage}")
execute_process(COMMAND dpkg-deb --root-owner-group -Zzstd -z3 --threads-max=2 --build "${stage}" "${package}" RESULT_VARIABLE rv)
if(NOT rv EQUAL 0)
    message(FATAL_ERROR "Drum content packaging failed")
endif()
message(STATUS "Built ${package}")
